{
  "name": "mastra-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "mastra dev",
    "typecheck": "tsc --noEmit",
    "rag:qdrant:up": "bash scripts/qdrant-up.sh",
    "rag:qdrant:down": "bash scripts/qdrant-down.sh",
    "rerank:up": "bash scripts/rerank-up.sh",
    "rerank:down": "bash scripts/rerank-down.sh",
    "rerank:status": "bash scripts/rerank-status.sh",
    "rerank:selftest": "bash scripts/rerank-up.selftest.sh",
    "rag:ingest": "node --env-file-if-exists=../.env --import tsx src/rag/ingest.ts",
    "rag:search": "node --env-file-if-exists=../.env --import tsx src/rag/search.ts",
    "rag:test": "node --env-file-if-exists=../.env --import tsx --test src/rag/rag.test.ts",
    "rerank:test": "node --env-file-if-exists=../.env --import tsx --test src/rag/rerank.test.ts",
    "agent:test:unit": "node --env-file-if-exists=../.env --import tsx --test src/mastra/tools/query-order-tool.test.ts src/mastra/orchestration.test.ts",
    "agent:test:live": "node --env-file-if-exists=../.env --import tsx --test src/mastra/tools/search-knowledge-base-tool.test.ts src/mastra/agent.e2e.test.ts",
    "agent:test": "npm run agent:test:unit && npm run agent:test:live",
    "test": "npm run typecheck && npm run agent:test:unit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.19",
    "@mastra/client-js": "1.33.0",
    "@mastra/core": "^1.52.1",
    "@mastra/qdrant": "^1.1.2",
    "@mastra/rag": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "mastra": "^1.20.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
