{
  "name": "mastra-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "mastra dev",
    "typecheck": "tsc --noEmit",
    "rag:qdrant:up": "bash scripts/qdrant-up.sh",
    "rag:qdrant:down": "bash scripts/qdrant-down.sh",
    "rag:ingest": "node --env-file-if-exists=../.env --import tsx src/rag/ingest.ts",
    "rag:search": "node --env-file-if-exists=../.env --import tsx src/rag/search.ts",
    "rag:test": "node --env-file-if-exists=../.env --import tsx --test src/rag/rag.test.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.19",
    "@mastra/core": "^1.52.1",
    "@mastra/qdrant": "^1.1.2",
    "@mastra/rag": "^2.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "mastra": "^1.20.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
