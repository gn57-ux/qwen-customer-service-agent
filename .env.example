OPENAI_API_KEY=local-not-required
QLORA_BASE_URL=http://127.0.0.1:8000/v1
MOCK_BACKEND_URL=http://127.0.0.1:8001

# ---------------------------------------------------------------------------
# mastra-agent/src/mastra 客服 Agent 自身的配置。
# 生成模型必须走 FastAPI 的 OpenAI 兼容接口（8000），不得直连 llama-server（8002）。
# ---------------------------------------------------------------------------
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_LLM_API_KEY=local-not-needed
# LOCAL_LLM_MODEL_NAME=qwen3-8b-customer-service-production-v1
# queryOrderTool 对 Mock 后端请求的超时
# QUERY_ORDER_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# web-client/scripts/smoke.ts：前端共享客户端 smoke 测试指向的 Mastra 服务地址。
# 前端只应该访问这个端口（mastra dev 默认 4111），不得直连 FastAPI（8000）
# 或 llama-server（8002）。
# ---------------------------------------------------------------------------
# MASTRA_BASE_URL=http://127.0.0.1:4111

# ---------------------------------------------------------------------------
# Mac 本地推理服务（services/app.py）自身的配置，不是客户端配置。
# ---------------------------------------------------------------------------
# 后端选择：llama_cpp 是 Mac 上的默认长期路径（PyTorch+MPS 全精度经受控探测证明
# 不可安全运行，见 services/MPS-FAILURE-REPORT.md）。pytorch_peft 必须显式设置才
# 启用，仅用于课程代码验收与未来 CUDA 机器，Mac 上不会自动选择它。
# LLM_BACKEND=llama_cpp

# ---- llama_cpp backend：FastAPI（8000）是唯一对外入口，转发给内部 llama-server（8002）----
# LLAMA_CPP_BASE_URL=http://127.0.0.1:8002
# LLAMA_CPP_HEALTH_TIMEOUT_S=3
# LLAMA_CPP_REQUEST_TIMEOUT_S=120
# GGUF_DIR=./models/gguf/qwen3-8b-production-v1
# ADAPTER_SCALE=1.0
# llama-server 自身端口/ctx 由 services/llama-server-up.sh 的 LLAMA_CPP_PORT /
# LLAMA_CTX_SIZE 环境变量控制，默认端口 8002、ctx 4096。

# ---- pytorch_peft backend（显式设置 LLM_BACKEND=pytorch_peft 才生效）----
# 默认值假设仓库标准布局：models/Qwen3-8B 与
# models/adapters/customer-service-production-v1（均已 .gitignore，需人工恢复/下载）。
# BASE_MODEL_PATH=./models/Qwen3-8B
# ADAPTER_PATH=./models/adapters/customer-service-production-v1
# EXPECTED_BASE_REVISION=b968826d9c46dd6066d109eabc6255188de91218
# ADAPTER_VERSION_NAME=customer-service-production-v1

# 设备/精度：auto 在 Mac 上会选 MPS，并先实测 bf16，不可用才显式降级 float16。
# CUDA 支持保留为未来兼容能力。受控探测已证明 Mac 上全精度 MPS 推理会在生成阶段
# 触发 critical 内存压力（driver_allocated≈29.75GB），不建议在 Mac 上真实启用。
# DEVICE=auto
# DTYPE=auto

# 生成默认值：默认确定性（temperature=0 → do_sample=False），两个 backend 共用
# DEFAULT_TEMPERATURE=0.0
# DEFAULT_TOP_P=1.0
# DEFAULT_MAX_TOKENS=512
# MAX_TOKENS_CEILING=1024
# MAX_INPUT_TOKENS=4096
# MAX_MESSAGES=64
# ENABLE_THINKING=false
# MODEL_NAME=qwen3-8b-customer-service-production-v1

# 测试专用：必须同时设置这两项才会跳过真实加载，生产环境永远严格加载。
# APP_ENV=test
# CS_SKIP_MODEL_LOAD=true


# ---------------------------------------------------------------------------
# RAG 向量入库阶段（Qdrant + 本地 bge-m3）
# ---------------------------------------------------------------------------
# Qdrant：docker-compose.rag.yml 只监听 127.0.0.1，不对外暴露
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=customer_service_knowledge

# Embedding：本地 Ollama 的 OpenAI 兼容端点，不使用任何云端 Embedding
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3
# 期望维度；运行时会对模型实测并比对，不一致直接失败
EMBEDDING_DIMENSION=1024

# 可选：摄取范围。默认只摄取 repair；加入政策文档时改为 "repair/*.md,policies/*.md"
# KNOWLEDGE_ROOT=knowledge
# KNOWLEDGE_GLOBS=repair/*.md

# 可选：分块参数（中文字符数）
# CHUNK_MAX_CHARS=800
# CHUNK_MIN_CHARS=400
# CHUNK_OVERLAP_CHARS=100

# ---------------------------------------------------------------------------
# 独立 Reranker（llama.cpp + bge-reranker-v2-m3，Apache-2.0）
# ---------------------------------------------------------------------------
# 真 cross-encoder：query 与 document 同一次前向打分，不是向量分数加权。
RERANK_BASE_URL=http://127.0.0.1:8787
# 显式关闭时检索走纯向量顺序，并明确标注未经过 Rerank；
# 保持 true 时若服务不可用，返回 unavailable 而不是静默降级。
RERANK_ENABLED=true
RERANK_TIMEOUT_MS=60000
RERANK_HEALTH_TIMEOUT_MS=3000

# 召回与最终条数：向量召回 Top20 → Rerank 取 Top5
RAG_RECALL_TOP_N=20
RAG_FINAL_TOP_K=5
